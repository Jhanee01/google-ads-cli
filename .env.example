# OAuth2 client (Google Cloud console, "Desktop app" client)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Long-lived refresh token for the user that can access the account
GOOGLE_ADS_REFRESH_TOKEN=
# Developer token (Google Ads API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=
# Only when you reach the account through a manager (MCC) account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Default account (no dashes); can be overridden per command with --customer-id
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26

# Safety
# Commands the CLI refuses to run. Give an agent DENY_COMMANDS=apply so it can only propose plans.
DENY_COMMANDS=
# set-budget refuses a bigger change than this (percent) without --force
MAX_BUDGET_CHANGE_PCT=50
# Where plans and the audit log are written
PLANS_DIR=./plans
AUDIT_LOG=./audit.log.jsonl
# Plans older than this cannot be applied (hours)
PLAN_TTL_HOURS=24
